---
import Windmill from './Windmill.astro';

const hearts = [
  { top: '4%', left: '46%', size: 24, color: '#ff9fbd', tilt: 0 },
  { top: '26%', left: '7%', size: 34, color: '#ffb3d1', tilt: -14 },
  { top: '32%', right: '8%', size: 28, color: '#c9a8ff', tilt: 12 },
  { top: '72%', left: '3%', size: 26, color: '#a8d4ff', tilt: 10 },
  { top: '44%', right: '3%', size: 32, color: '#ff9fbd', tilt: -10 },
  { top: '62%', left: '36%', size: 20, color: '#ffc4dd', tilt: 0 },
];
---

<div class="background" aria-hidden="true">
  <svg class="rainbow rainbow-left" viewBox="0 0 200 116">
    <use href="#rainbow" />
  </svg>
  <svg class="rainbow rainbow-right" viewBox="0 0 200 116">
    <use href="#rainbow" />
  </svg>

  {
    hearts.map(({ size, color, tilt, ...position }) => (
      <svg
        class="heart"
        viewBox="0 0 32 30"
        width={size}
        height={size}
        style={{ ...position, fill: color, transform: `rotate(${tilt}deg)` }}
      >
        <path d="M16 28 C4 19 1 13 1 8.5 C1 4 4.5 1 8.5 1 C11.5 1 14.5 3 16 6 C17.5 3 20.5 1 23.5 1 C27.5 1 31 4 31 8.5 C31 13 28 19 16 28Z" />
      </svg>
    ))
  }

  <Windmill side="left" />
  <Windmill side="right" />

  <svg class="flag" viewBox="0 0 100 100" role="img" aria-label="Dutch flag">
    <rect x="8" y="4" width="5" height="96" rx="2" fill="#a98a6a" />
    <circle cx="10.5" cy="5" r="5" fill="#ffd66e" />
    <path d="M13 10 C35 2 60 18 92 10 V24 C60 32 35 16 13 24Z" fill="#d6323f" />
    <path d="M13 24 C35 16 60 32 92 24 V38 C60 46 35 30 13 38Z" fill="#fff" />
    <path d="M13 38 C35 30 60 46 92 38 V52 C60 60 35 44 13 52Z" fill="#2f5fa8" />
  </svg>

  <div class="canal-houses"></div>

  <svg class="animal bunny" viewBox="0 0 100 120">
    <ellipse cx="34" cy="32" rx="11" ry="30" fill="#fff" stroke="#e9a9bd" stroke-width="3" />
    <ellipse cx="66" cy="32" rx="11" ry="30" fill="#fff" stroke="#e9a9bd" stroke-width="3" />
    <ellipse cx="34" cy="34" rx="5" ry="20" fill="#ffd0dd" />
    <ellipse cx="66" cy="34" rx="5" ry="20" fill="#ffd0dd" />
    <ellipse cx="50" cy="82" rx="38" ry="34" fill="#fff" stroke="#e9a9bd" stroke-width="3" />
    <circle cx="37" cy="78" r="4" fill="#4a3b4f" />
    <circle cx="63" cy="78" r="4" fill="#4a3b4f" />
    <path d="M46 88 Q50 92 54 88" fill="none" stroke="#4a3b4f" stroke-width="2.5" stroke-linecap="round" />
    <ellipse cx="27" cy="90" rx="7" ry="4" fill="#ffc0d0" />
    <ellipse cx="73" cy="90" rx="7" ry="4" fill="#ffc0d0" />
  </svg>

  <svg class="animal chick" viewBox="0 0 100 92">
    <path d="M50 12 Q44 2 40 8 M50 12 Q54 0 60 7" fill="none" stroke="#f0c95a" stroke-width="3" stroke-linecap="round" />
    <ellipse cx="50" cy="52" rx="40" ry="38" fill="#fff0a8" stroke="#f0c95a" stroke-width="3" />
    <circle cx="36" cy="46" r="4" fill="#4a3b4f" />
    <circle cx="64" cy="46" r="4" fill="#4a3b4f" />
    <path d="M43 54 L57 54 L50 63Z" fill="#ffb066" />
    <ellipse cx="24" cy="58" rx="7" ry="4" fill="#ffc0a8" />
    <ellipse cx="76" cy="58" rx="7" ry="4" fill="#ffc0a8" />
  </svg>

  <svg class="animal kitty" viewBox="0 0 100 90">
    <path d="M16 36 L14 4 L42 20Z" fill="#ffd9a8" stroke="#e8ae6e" stroke-width="3" stroke-linejoin="round" />
    <path d="M84 36 L86 4 L58 20Z" fill="#ffd9a8" stroke="#e8ae6e" stroke-width="3" stroke-linejoin="round" />
    <ellipse cx="50" cy="52" rx="40" ry="34" fill="#ffd9a8" stroke="#e8ae6e" stroke-width="3" />
    <circle cx="35" cy="48" r="4" fill="#4a3b4f" />
    <circle cx="65" cy="48" r="4" fill="#4a3b4f" />
    <path d="M45 58 Q50 63 50 58 Q50 63 55 58" fill="none" stroke="#4a3b4f" stroke-width="2.5" stroke-linecap="round" />
    <ellipse cx="24" cy="60" rx="7" ry="4" fill="#ffb7a8" />
    <ellipse cx="76" cy="60" rx="7" ry="4" fill="#ffb7a8" />
  </svg>

  <svg width="0" height="0">
    <symbol id="rainbow" viewBox="0 0 200 116">
      <g fill="none" stroke-width="11" stroke-linecap="round">
        <path d="M15 100 A85 85 0 0 1 185 100" stroke="#ffb3ba" />
        <path d="M27 100 A73 73 0 0 1 173 100" stroke="#ffd8a8" />
        <path d="M39 100 A61 61 0 0 1 161 100" stroke="#fff3a6" />
        <path d="M51 100 A49 49 0 0 1 149 100" stroke="#baf0c8" />
        <path d="M63 100 A37 37 0 0 1 137 100" stroke="#b5d8ff" />
        <path d="M75 100 A25 25 0 0 1 125 100" stroke="#dcc6ff" />
      </g>
      <g fill="#fff">
        <circle cx="15" cy="100" r="13" />
        <circle cx="33" cy="104" r="11" />
        <circle cx="185" cy="100" r="13" />
        <circle cx="167" cy="104" r="11" />
      </g>
    </symbol>
  </svg>
</div>

<style>
  .background {
    position: absolute;
    inset: 0;
    --skyline: clamp(90px, 18vh, 170px);
    overflow: hidden;
    pointer-events: none;
  }

  .canal-houses {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: var(--skyline);
    background: url('/canal-houses.svg') center bottom / auto 100% repeat-x;
  }

  .flag {
    position: absolute;
    bottom: calc(var(--skyline) * 0.6);
    left: 50%;
    width: clamp(48px, min(8vw, 9vh), 84px);
    transform: translateX(-50%);
  }

  .rainbow,
  .heart,
  .animal {
    position: absolute;
  }

  .rainbow {
    width: clamp(130px, 26vw, 300px);
  }

  .rainbow-left {
    top: 18px;
    left: -30px;
  }

  .rainbow-right {
    top: 60px;
    right: -40px;
    transform: rotate(8deg);
  }

  .animal {
    bottom: calc(var(--skyline) * 0.08);
    width: clamp(64px, min(12vw, 16vh), 110px);
  }

  .bunny {
    left: 3%;
  }

  .chick {
    left: 50%;
    width: clamp(52px, min(8vw, 11vh), 76px);
    transform: translateX(-50%);
  }

  .kitty {
    right: 4%;
  }

  @media (orientation: landscape) and (max-height: 520px) {
    .background {
      --skyline: 64px;
    }

    .rainbow {
      width: 130px;
    }

    .rainbow-right {
      top: 18px;
    }
  }
</style>
