---
import Background from '../components/Background.astro';
import Panda from '../components/Panda.astro';
import { games } from '../data/games';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <meta name="theme-color" content="#ffe3ee" />
    <link rel="icon" type="image/svg+xml" href="favicon.svg" />
    <title>Anna's Games</title>
  </head>
  <body>
    <Background />
    <main>
      <Panda />
      <div class="intro">
        <h1>Hi, I'm Anna!</h1>
        <p class="tagline">Come play my games ♥</p>
        <div class="games">
          {
            games.length > 0 ? (
              games.map(({ title, folder }) => (
                <a class="tile" href={`games/${folder}/`}>
                  ♥ {title}
                </a>
              ))
            ) : (
              <p class="tile">Games coming soon ♥</p>
            )
          }
        </div>
      </div>
    </main>
  </body>
</html>

<style is:global>
  * {
    box-sizing: border-box;
  }

  html {
    -webkit-text-size-adjust: 100%;
    text-size-adjust: 100%;
  }

  body {
    position: relative;
    min-height: 100vh;
    min-height: 100dvh;
    margin: 0;
    background: linear-gradient(170deg, #ffe3ee 0%, #f2e6ff 50%, #e3f1ff 100%);
    color: #5b3a6b;
    font-family: 'Comic Sans MS', 'Chalkboard SE', system-ui, sans-serif;
    text-align: center;
  }
</style>

<style>
  main {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 100vh;
    min-height: 100dvh;
    padding: 40px 24px clamp(100px, 18vh, 170px);
  }

  .intro {
    width: 100%;
    max-width: 640px;
  }

  h1 {
    margin: 8px 0 4px;
    font-size: clamp(30px, 7vw, 56px);
  }

  .tagline {
    margin: 0 0 clamp(20px, 3vh, 32px);
    font-size: clamp(17px, 3vw, 24px);
  }

  .games {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(190px, 100%), 1fr));
    gap: 16px;
  }

  .tile {
    margin: 0;
    padding: clamp(20px, 3.5vw, 34px) 10px;
    border-radius: 22px;
    background: #fff;
    box-shadow: 0 5px 0 #f6b9cf;
    color: inherit;
    font-size: clamp(17px, 2.6vw, 22px);
    text-decoration: none;
  }

  a.tile:active {
    transform: translateY(2px);
  }

  a.tile:nth-child(even) {
    box-shadow: 0 5px 0 #b9d6f6;
  }

  @media (hover: hover) {
    a.tile:hover {
      transform: translateY(-3px);
    }
  }

  @media (orientation: landscape) and (max-height: 520px) {
    main {
      flex-direction: row;
      gap: 24px;
      padding: 16px 24px 28px;
    }

    .intro {
      max-width: 340px;
    }

    h1 {
      margin-top: 0;
      font-size: 38px;
    }

    .tagline {
      margin-bottom: 12px;
      font-size: 18px;
    }

    .tile {
      padding: 14px 10px;
    }
  }
</style>
